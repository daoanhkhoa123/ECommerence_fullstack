SERVER_PORT = 8000

DATABASE_URL=postgresql://admin_aimodule:admin123@localhost:5433/aimodule_db

KAFKA_URL=localhost:9092
KAFKA_GROUP=aimodule-group  
KAFKA_CONSUMER_HANDLERS=src.allocation.entrypoints.message_broker.consumer.consumer_handlers
KAFKA_PRODUCER_HANDLERS=src.allocation.entrypoints.message_broker.producer.producer_handlers
KAFKA_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=1000
KAFKA_ACKS=all

GOOGLE_LLM = gemini-2.5-flash
GOOGLE_EMBEDDING = models/text-embedding-004a

SRC_PATH=src